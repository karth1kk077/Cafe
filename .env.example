# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cafe_db?schema=public

# App
NODE_ENV=development
API_PORT=4000
WEB_PORT=5173
API_BASE_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:5173
# Public origin encoded into table QR codes (what customers scan).
# Defaults to WEB_ORIGIN when unset; set it explicitly in production.
PUBLIC_APP_BASE_URL=http://localhost:5173

# Security
JWT_SECRET=change-me-in-dev
SESSION_SECRET=change-me-in-dev
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
BCRYPT_ROUNDS=12

# Café
CAFE_NAME=Smart Café
CURRENCY=INR

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
ORDER_RATE_LIMIT_MAX=30
# Stricter budget for the QR-first session-open endpoint.
SESSION_RATE_LIMIT_MAX=10
# Close a customer-opened session that never produced an order after this
# many milliseconds (default 30 minutes).
CUSTOMER_SESSION_IDLE_TIMEOUT_MS=1800000

# Feature flags
ENABLE_GATEWAY_PAYMENTS=false
